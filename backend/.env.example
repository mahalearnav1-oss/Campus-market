# ==============================================================================
# CampusMarket Backend API — Environment Variables Template
# ==============================================================================
# Copy this file to backend/.env and customize for your local environment.
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Connection (MySQL 8.0+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/campusmarket"

# Authentication & JWT Secrets
JWT_SECRET=development_secret_key_campusmarket_2026_min32
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=development_refresh_secret_key_campusmarket_2026_min32
REFRESH_TOKEN_EXPIRES_IN=7d

# Payment Gateway (Razorpay - Default Sandbox Test Credentials)
RAZORPAY_KEY_ID=rzp_test_campusmarket2026
RAZORPAY_KEY_SECRET=test_secret_campusmarket_key_2026
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_2026

# Administrator Password for optional seed / reset utilities
ADMIN_PASSWORD=AdminSecure2026!
ADMIN_EMAIL=admin@harvard.edu