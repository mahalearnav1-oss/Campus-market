# ==============================================================================
# CampusMarket Monorepo — Environment Variables Template
# ==============================================================================
# Copy this file to backend/.env (or .env at root) and adjust values as needed.
#
# QUICK START:
#   1. Make sure MySQL is running and your database exists (e.g. CREATE DATABASE campusmarket;)
#   2. Update DATABASE_URL below with your MySQL username and password.
#   3. Run `npm run setup` to initialize the database schema and Prisma client.
#   4. Run `npm run dev` to start the frontend and backend servers.
# ==============================================================================

# Server & Environment Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Connection (MySQL 8.0+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/campusmarket"

# Authentication & Security
# IMPORTANT: Use secure random strings for production deployments.
JWT_SECRET=development_secret_key_campusmarket_2026_min32
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=development_refresh_secret_key_campusmarket_2026_min32
REFRESH_TOKEN_EXPIRES_IN=7d

# Payment Gateway (Razorpay - Optional Test Keys for Development)
RAZORPAY_KEY_ID=rzp_test_campusmarket2026
RAZORPAY_KEY_SECRET=test_secret_campusmarket_key_2026
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_2026

# Optional: Initial Administrator Password (used during database reset/seed)
ADMIN_PASSWORD=AdminSecure2026!
