# ==========================================
# CampusMarket Environment Variables Template
# ==========================================

# Server & Node Configuration
NODE_ENV=development
API_PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusmarket?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_min_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_min_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage & CDN (AWS S3 / Cloudflare R2 - Placeholders)
AWS_REGION=us-east-1
S3_BUCKET_NAME=campusmarket-uploads
S3_ACCESS_KEY_ID=placeholder_access_key
S3_SECRET_ACCESS_KEY=placeholder_secret_key

# Payment Gateway (Stripe / Razorpay - Placeholders)
PAYMENT_GATEWAY_SECRET_KEY=sk_test_placeholder
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_placeholder

# Redis Cache & Queue (BullMQ - Placeholders)
REDIS_HOST=localhost
REDIS_PORT=6379
